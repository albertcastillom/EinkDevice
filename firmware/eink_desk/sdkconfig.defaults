# Waveshare ESP32-S3 e-Paper 3.97 hardware
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Lower the CPU clock while idle. Deep sleep handles long idle periods; automatic
# light sleep is intentionally disabled so rocker GPIO interrupts remain reliable.
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# Leave room for two OTA firmware images and uploaded wallpapers.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
